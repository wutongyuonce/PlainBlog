---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { selectPublished } from "../lib/publication.mjs";
import { site } from "../config";
import HomeIntro from "../content/pages/home.md";

const icons: Record<string, string> = {
  GitHub:
    "M8 1.4a6.6 6.6 0 0 0-2.1 12.86c.33.06.45-.14.45-.32v-1.1c-1.82.4-2.2-.88-2.2-.88-.3-.75-.72-.95-.72-.95-.58-.4.05-.39.05-.39.64.05 1 .66 1 .66.58.98 1.51.7 1.88.53.06-.42.23-.7.41-.86-1.45-.16-2.97-.72-2.97-3.22 0-.71.25-1.29.67-1.75-.07-.16-.29-.83.06-1.72 0 0 .55-.18 1.8.67a6.2 6.2 0 0 1 3.28 0c1.25-.85 1.8-.67 1.8-.67.35.89.13 1.56.07 1.72.41.46.66 1.04.66 1.75 0 2.51-1.53 3.06-2.98 3.22.23.2.44.6.44 1.21v1.8c0 .18.12.38.45.32A6.6 6.6 0 0 0 8 1.4",
  X: "M3.1 3.3 6.9 8.2 3.3 12.7h1.2l2.9-3.4 2.3 3.4h3.2L9.1 7.6l3.4-4.3h-1.2L8.5 6.5 6.3 3.3H3.1z",
  B站: "M4.2 3.1 5.5 5M11.8 3.1 10.5 5M2.4 5.4h11.2a1.2 1.2 0 0 1 1.2 1.2v6.2a1.2 1.2 0 0 1-1.2 1.2H2.4a1.2 1.2 0 0 1-1.2-1.2V6.6a1.2 1.2 0 0 1 1.2-1.2zM5.2 8.2v2.2M10.8 8.2v2.2",
  小红书:
    "M3.2 2.6h9.6a1.4 1.4 0 0 1 1.4 1.4v8a1.4 1.4 0 0 1-1.4 1.4H3.2a1.4 1.4 0 0 1-1.4-1.4v-8a1.4 1.4 0 0 1 1.4-1.4zM5.2 8.4c.7-1.3 1.6-2 2.8-2s2.1.7 2.8 2",
};
const escapeHtml = (value: string) =>
  value.replace(
    /[&<>"]/g,
    (char) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[char]!,
  );
const socialMarkup = (site.social ?? [])
  .map((item, index) => {
    const separator =
      index === 0 ? "" : index === site.social.length - 1 ? "和" : "、";
    const kind =
      item.label === "B站" || item.label === "小红书" ? "stroke" : "fill";
    return `${separator}<a class="social-link" href="${escapeHtml(item.href)}" rel="noreferrer"><svg aria-hidden="true" viewBox="0 0 16 16" class="${kind}"><path d="${escapeHtml(icons[item.label] ?? "")}"/></svg><span>${escapeHtml(item.label)}</span></a>`;
  })
  .join("");
const posts = selectPublished(await getCollection("posts"));
const years = [...new Set(posts.map((post) => post.data.date.slice(0, 4)))];
---

<Base title="Home" description={site.description}>
  <h1 class="home-title">{site.name}</h1>
  <div class="intro">
    <HomeIntro />
    {
      socialMarkup && (
        <p>
          也可以在
          <span set:html={socialMarkup} />
          看看。
        </p>
      )
    }
  </div>
  {posts.length === 0 && <p>还没有公开文章。</p>}
  {
    years.map((year) => (
      <section
        class="year-group"
        data-year={year}
        aria-label={`${year} 年文章`}
      >
        <h2>{year}</h2>
        <ul class="post-list">
          {posts
            .filter((post) => post.data.date.startsWith(year))
            .map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                <time datetime={post.data.date}>
                  {post.data.date.slice(5).replace("-", "/")}
                </time>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</Base>
